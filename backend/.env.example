# Client ID web de Google Cloud Console (verificacion de idToken en /auth/google)
GOOGLE_CLIENT_ID=

# Clave para firmar los JWT. Generar una aleatoria por entorno.
SECRET_KEY=

# URL de la base de datos. Local: sqlite:///./backend.db (default si se omite)
# Produccion (Render): postgresql://user:pass@host/dbname
DATABASE_URL=

# Envio de correos (codigos de recuperacion).
# Produccion (Render): Gmail API HTTPS — los puertos SMTP estan bloqueados.
# Credenciales del cliente OAuth "App de escritorio" autorizado por la cuenta
# remitente (scope gmail.send). Generar: python tools/get_gmail_token.py <json>
GMAIL_SENDER_CLIENT_ID=
GMAIL_SENDER_CLIENT_SECRET=
GMAIL_SENDER_REFRESH_TOKEN=

# Alternativa local: SMTP con "contrasena de aplicacion" de Gmail
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rendimiento en entornos con poca RAM (Render free: 512MB)
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
