# Client ID web de Google Cloud Console (verificacion de idToken en /auth/google)
GOOGLE_CLIENT_ID=

# Clave para firmar los JWT. Generar una aleatoria por entorno.
SECRET_KEY=

# URL de la base de datos. Local: sqlite:///./backend.db (default si se omite)
# Produccion (Render): postgresql://user:pass@host/dbname
DATABASE_URL=

# Envio de correos (codigos de recuperacion).
# Produccion (Render): Brevo API HTTPS — los puertos SMTP estan bloqueados.
# Generar key en https://app.brevo.com/settings/keys con la cuenta del remitente.
BREVO_API_KEY=

# Alternativa local: SMTP con "contrasena de aplicacion" de Gmail
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rendimiento en entornos con poca RAM (Render free: 512MB)
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
